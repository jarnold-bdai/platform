{
  "name": "@jarnold-bdai/platform",
  "version": "0.1.1",
  "description": "Code shared by the bdai apps: DynamoDB migration runner and shared Zod schemas",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jarnold-bdai/platform.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "exports": {
    "./migrations": {
      "import": {
        "types": "./dist/esm/migrations/index.d.ts",
        "default": "./dist/esm/migrations/index.js"
      },
      "require": {
        "types": "./dist/cjs/migrations/index.d.ts",
        "default": "./dist/cjs/migrations/index.js"
      }
    },
    "./agentConfig": {
      "import": {
        "types": "./dist/esm/agentConfig/index.d.ts",
        "default": "./dist/esm/agentConfig/index.js"
      },
      "require": {
        "types": "./dist/cjs/agentConfig/index.d.ts",
        "default": "./dist/cjs/agentConfig/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "migrations": ["./dist/cjs/migrations/index.d.ts"],
      "agentConfig": ["./dist/cjs/agentConfig/index.d.ts"]
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json && node scripts/write-dist-package-json.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "verify:exports": "node scripts/verify-exports.mjs"
  },
  "peerDependencies": {
    "@aws-sdk/client-dynamodb": "^3.0.0",
    "@aws-sdk/util-dynamodb": "^3.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.600.0",
    "@aws-sdk/util-dynamodb": "^3.600.0",
    "@types/node": "^22.0.0",
    "aws-sdk-client-mock": "^4.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "zod": "^3.23.8"
  }
}
